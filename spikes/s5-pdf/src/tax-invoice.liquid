<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Tax Invoice {{ invoice.number }}</title>
<style>
  @page { size: A4; margin: 10mm; }
  * { box-sizing: border-box; }
  body { font-family: "DejaVu Sans", "Noto Sans", Arial, sans-serif; font-size: 8.5pt; color: #111; margin: 0; }
  .copy { page-break-after: always; }
  .copy:last-child { page-break-after: auto; }
  .bar { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #111; padding-bottom: 2mm; }
  .bar h1 { font-size: 15pt; margin: 0; letter-spacing: 0.5px; }
  .copy-label { font-weight: bold; font-size: 8pt; border: 1px solid #111; padding: 1mm 2mm; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #111; border-top: 0; }
  .grid > div { padding: 2mm; border-right: 1px solid #111; }
  .grid > div:last-child { border-right: 0; }
  .label { color: #555; font-size: 7pt; text-transform: uppercase; letter-spacing: 0.3px; }
  .name { font-weight: bold; font-size: 10pt; }
  .einv { display: grid; grid-template-columns: 1fr 34mm; border: 1px solid #111; border-top: 0; }
  .einv > div { padding: 2mm; }
  .einv svg { width: 30mm; height: 30mm; display: block; }
  .mono { font-family: "DejaVu Sans Mono", monospace; font-size: 7pt; word-break: break-all; }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 1px solid #111; padding: 1.2mm 1.5mm; vertical-align: top; }
  th { background: #eee; font-size: 7.5pt; }
  td.n, th.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  tr { page-break-inside: avoid; }
  thead { display: table-header-group; }
  .totals td { font-weight: bold; }
  .words { border: 1px solid #111; border-top: 0; padding: 2mm; }
  .foot { display: grid; grid-template-columns: 1.4fr 1fr; border: 1px solid #111; border-top: 0; min-height: 24mm; }
  .foot > div { padding: 2mm; }
  .sign { text-align: right; display: flex; flex-direction: column; justify-content: space-between; }
  .small { font-size: 7pt; color: #444; }
</style>
</head>
<body>
{% for copy in copies %}
<section class="copy">
  <div class="bar">
    <h1>TAX INVOICE</h1>
    <span class="copy-label">{{ copy }}</span>
  </div>

  <div class="grid">
    <div>
      <div class="label">Supplier</div>
      <div class="name">{{ supplier.name }}</div>
      <div>{{ supplier.address }}</div>
      <div>GSTIN: <b>{{ supplier.gstin }}</b> · State: {{ supplier.state }} ({{ supplier.state_code }})</div>
    </div>
    <div>
      <div>Invoice No: <b>{{ invoice.number }}</b></div>
      <div>Invoice Date: <b>{{ invoice.date }}</b></div>
      <div>Place of Supply: {{ invoice.place_of_supply }}</div>
      <div>Reverse Charge: {{ invoice.reverse_charge }}</div>
      <div>Job / PO Ref: {{ invoice.reference }}</div>
    </div>
  </div>

  <div class="grid">
    <div>
      <div class="label">Bill to (Recipient)</div>
      <div class="name">{{ buyer.name }}</div>
      <div>{{ buyer.address }}</div>
      <div>GSTIN: <b>{{ buyer.gstin }}</b> · State: {{ buyer.state }} ({{ buyer.state_code }})</div>
    </div>
    <div>
      <div class="label">Ship to</div>
      <div>{{ ship_to }}</div>
      <div class="small">Transport: {{ invoice.transport }}</div>
    </div>
  </div>

  {% if einvoice %}
  <div class="einv">
    <div>
      <div class="label">E-invoice</div>
      <div>IRN: <span class="mono">{{ einvoice.irn }}</span></div>
      <div>Ack No: {{ einvoice.ack_no }} · Ack Date: {{ einvoice.ack_date }}</div>
    </div>
    <div>{{ einvoice.qr_svg | raw }}</div>
  </div>
  {% endif %}

  <table>
    <thead>
      <tr>
        <th>#</th><th>Description</th><th>HSN/SAC</th><th class="n">Qty</th><th>UQC</th><th class="n">Rate</th>
        <th class="n">Taxable Value</th><th class="n">GST %</th>
        {% if intra %}<th class="n">CGST</th><th class="n">SGST</th>{% else %}<th class="n">IGST</th>{% endif %}
        <th class="n">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for l in lines %}
      <tr>
        <td>{{ forloop.index }}</td><td>{{ l.description }}</td><td>{{ l.hsn }}</td><td class="n">{{ l.qty }}</td><td>{{ l.uqc }}</td>
        <td class="n">{{ l.rate }}</td><td class="n">{{ l.taxable }}</td><td class="n">{{ l.gst_rate }}</td>
        {% if intra %}<td class="n">{{ l.cgst }}</td><td class="n">{{ l.sgst }}</td>{% else %}<td class="n">{{ l.igst }}</td>{% endif %}
        <td class="n">{{ l.total }}</td>
      </tr>
      {% endfor %}
      <tr class="totals">
        <td colspan="6">Total</td><td class="n">{{ totals.taxable }}</td><td></td>
        {% if intra %}<td class="n">{{ totals.cgst }}</td><td class="n">{{ totals.sgst }}</td>{% else %}<td class="n">{{ totals.igst }}</td>{% endif %}
        <td class="n">{{ totals.before_round_off }}</td>
      </tr>
      <tr><td colspan="{% if intra %}10{% else %}9{% endif %}">Round-off</td><td class="n">{{ totals.round_off }}</td></tr>
      <tr class="totals"><td colspan="{% if intra %}10{% else %}9{% endif %}">Invoice Total (INR)</td><td class="n">{{ totals.grand_total }}</td></tr>
    </tbody>
  </table>

  <div class="words"><span class="label">Amount in words</span><br><b>{{ totals.in_words }}</b></div>

  <div class="foot">
    <div class="small">
      <div class="label">Bank details</div>
      {{ supplier.bank }}<br><br>
      <div class="label">Terms</div>
      {{ terms }}
    </div>
    <div class="sign">
      <div>For <b>{{ supplier.name }}</b></div>
      <div>Authorised Signatory</div>
    </div>
  </div>
</section>
{% endfor %}
</body>
</html>
