<!doctype html><html><head><meta charset="utf-8"><style>@page { size: A4; margin: 12mm } body { font-family: sans-serif; font-size: 10pt }</style></head>
<body>{% for copy in copies %}<section style="page-break-after: always"><h1>{{ title }}</h1><p>{{ copy }}</p>
<p>{% render 'branding', company: company %}</p><p>To: {{ customer }}</p>
<table>{% for l in lines %}<tr><td>{{ l.item }}</td><td>{{ l.qty }}</td></tr>{% endfor %}</table></section>{% endfor %}</body></html>
